import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
from sklearn.linear_model import LinearRegression

# Load the data
data = pd.read_csv("/content/sample_data/Salary_dataset.csv", encoding="latin-1")

# Explain the data
print("This dataset contains salary data vs years of experience.")
print("Each row represents one employee.")
print("We use:")
print("- YearsExperience as the input feature (X)")
print("- Salary as the target output (y)")
print("Shape:", data.shape)
print("Columns:", list(data.columns))
print(data.head())

# Keep only the two columns we need
data_small = data[["YearsExperience", "Salary"]].dropna()

# Correlation:
# Measures how strongly experience and salary move together
# (close to 1 = strong positive linear relationship, which justifies a linear model)
print("Correlation:", data_small["YearsExperience"].corr(data_small["Salary"]))

# scikit-learn xpects 2D arrays (rows = samples, columns = features),
# so np.c_ turns each column into a 2D column vector
X = np.c_[data_small["YearsExperience"]]
y = np.c_[data_small["Salary"]]

# Scatter plot: 
# Checks visually whether the relationship looks roughly linear
data_small.plot(kind="scatter", x="YearsExperience", y="Salary")
plt.show()

# Histogram: 
# Shows how salaries are distributed (spread, skew, outliers)
plt.figure()
plt.hist(data_small["Salary"], bins=15, edgecolor="black")
# Graph details
plt.title("Histogram of Salaries")
plt.xlabel("Salary")
plt.ylabel("Number of Employees")
plt.show()

# Select a linear model
model = LinearRegression()

# Train the model:
# Finds the best-fit line (slope and intercept)
model.fit(X, y)

# Predict: 
# X_new must also be 2D, hence the double brackets [[#]]
X_new = [[5]]  # 5 years of experience
print("Predicted salary for 5 years experience:", model.predict(X_new)[0][0])
